{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GeodipoRegionalRAGSchema",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "name",
        "province",
        "cat_esdm",
        "geological_sheet",
        "coordinates"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "province": {
          "type": "string"
        },
        "cat_esdm": {
          "type": "string"
        },
        "bbws": {
          "type": "string"
        },
        "geological_sheet": {
          "type": "string"
        },
        "coordinates": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number"
            },
            "lng": {
              "type": "number"
            }
          }
        }
      }
    },
    "secondary_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "authors",
          "year",
          "publication",
          "institution",
          "key_findings",
          "citation"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "authors": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "publication": {
            "type": "string"
          },
          "institution": {
            "type": "string"
          },
          "key_findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "citation": {
            "type": "string"
          }
        }
      }
    },
    "hydrogeology": {
      "type": "object",
      "properties": {
        "aquifer_shallow": {
          "type": "object"
        },
        "aquifer_confined": {
          "type": "object"
        }
      }
    },
    "geotechnical": {
      "type": "object",
      "properties": {
        "soil_profile": {
          "type": "array"
        },
        "hazard": {
          "type": "string"
        }
      }
    }
  }
}